# Copy to .env locally; never commit the filled file.
RIT_ENV=local
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen
DATABASE_USER=rit_canteen
DATABASE_PASSWORD=replace-with-a-local-random-password
DEMO_SEED_ENABLED=true
# For full PostgreSQL integration tests, create three separate disposable DBs.
# RIT_TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen_test
# RIT_TEST_FRESH_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen_fresh
# RIT_TEST_LEGACY_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen_legacy
# RIT_TEST_DATABASE_USER=rit_canteen
# RIT_TEST_DATABASE_PASSWORD=replace-with-a-separate-local-random-password
# RIT_INTEGRATION_DISPOSABLE_APP_DB=YES
# RIT_INTEGRATION_DISPOSABLE_TEST_DB=YES
# RIT_INTEGRATION_DISPOSABLE_FRESH_DB=YES
# RIT_INTEGRATION_DISPOSABLE_LEGACY_DB=YES
