# Copy to .env locally; never commit the filled file.
RIT_ENV=local
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen
DATABASE_USER=rit_canteen
DATABASE_PASSWORD=replace-with-a-local-random-password
DEMO_SEED_ENABLED=true
# Public hosting is a separate profile. Never set the local seed flag in Render.
# RIT_ENV=cloud_demo
# HTTP_HOST=0.0.0.0
# PORT is supplied by Render.
# DATABASE_URL=jdbc:postgresql://<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# DATABASE_USER=<SESSION_POOLER_USERNAME>
# DATABASE_PASSWORD=<private database password>
# RIT_CLOUD_DEMO_SEED_ENABLED=true
# RIT_CLOUD_DEMO_CUSTOMER_EMAIL=<private demo-only address>
# RIT_CLOUD_DEMO_CUSTOMER_PASSWORD=<unique strong private password>
# RIT_CLOUD_DEMO_OWNER_EMAIL=<different private demo-only address>
# RIT_CLOUD_DEMO_OWNER_PASSWORD=<different unique strong private password>
# Optional, owner-approved demo customer signup with self-declared Student/Faculty status.
# No OTP/email verification or seller/admin role grant. Default false; never enable in production.
# RIT_CLOUD_DEMO_SELF_SIGNUP_ENABLED=true
# DB_POOL_SIZE=2
# For full PostgreSQL integration tests, create three separate disposable DBs.
# RIT_TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen_test
# RIT_TEST_FRESH_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen_fresh
# RIT_TEST_LEGACY_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rit_canteen_legacy
# RIT_TEST_DATABASE_USER=rit_canteen
# RIT_TEST_DATABASE_PASSWORD=replace-with-a-separate-local-random-password
# RIT_INTEGRATION_DISPOSABLE_APP_DB=YES
# RIT_INTEGRATION_DISPOSABLE_TEST_DB=YES
# RIT_INTEGRATION_DISPOSABLE_FRESH_DB=YES
# RIT_INTEGRATION_DISPOSABLE_LEGACY_DB=YES
